<Window x:Class="NewgaonPcOff.UI.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC-OFF — 수집하는 정보"
        Width="580" Height="640"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CardBg}"
        FontFamily="{StaticResource UiFont}">

    <!-- 근로자 고지 화면.
         노무사 자료(제4권)의 권고: "무엇을 수집하는지"보다 **"무엇을 수집하지 않는지"** 를 명시하는 것이
         감시 논란에 대한 가장 강한 방어선이다. 그래서 두 목록을 나란히 둔다. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,22,24,0">
            <TextBlock Style="{StaticResource TitleText}" Text="이 프로그램이 다루는 정보" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                       Text="PC-OFF는 근무시간이 끝난 뒤 화면을 잠그는 프로그램입니다. 아래가 전부이며, 목록에 없는 것은 수집하는 기능 자체가 없습니다." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <!-- 보내는 것 -->
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLine}"
                        Background="{StaticResource PageBg}" Padding="16,14,16,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Foreground="{StaticResource TextMain}"
                                   FontSize="14" Text="회사 서버로 보내는 것 (전부)" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 이 컴퓨터 이름 — 관리자 [PC관리] 화면에 표시" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 프로그램 버전, 마지막 연락 시각 — 켜져 있는지 확인용" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 일어난 일의 종류와 시각 — 잠금 · 해제 · 일시사용 · 사전알림 · 오프라인 · 연결" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· [일시사용]을 쓸 때 회사가 정한 목록에서 고른 사유 (직접 적는 칸은 없습니다)" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 잠금화면에서 연장근무를 신청한 경우 그 신청 내용 (날짜 · 시각 · 사유)" />
                    </StackPanel>
                </Border>

                <!-- 보내지 않는 것 -->
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#BBF7D0"
                        Background="#F0FDF4" Padding="16,14,16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Foreground="#15803D"
                                   FontSize="14" Text="보내지 않는 것 (수집 기능이 아예 없습니다)" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 화면 캡처, 화면에 무엇이 떠 있는지" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 키보드로 무엇을 입력했는지 (키로깅)" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 실행 중인 프로그램 목록, 방문한 웹사이트" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 파일 · 문서 · 메일 내용" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 마이크 · 카메라 · 위치 정보" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 자리를 비운 시간, 얼마나 쉬었는지" />
                    </StackPanel>
                </Border>

                <!-- 이 PC 안에만 남는 것 -->
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLine}"
                        Background="{StaticResource CardBg}" Padding="16,14,16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Foreground="{StaticResource TextMain}"
                                   FontSize="14" Text="이 PC 안에만 남고, 서버로 보내지 않는 것" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 진단 기록 — 서버 연결이 됐는지 같은 동작 기록. 14일 뒤 자동 삭제됩니다." />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 연결 정보 — 서버 주소, 이 컴퓨터 이름, 연결된 회사·이름, 연결한 시각" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 이 PC를 증명하는 열쇠 — 윈도우 암호보호로 잠가 보관합니다(다른 계정·다른 PC에서는 열리지 않습니다)" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 회사 근무시간 설정 사본 — 인터넷이 끊겨도 판단할 수 있게 암호화해 보관합니다." />
                    </StackPanel>
                </Border>

                <!-- 보관기간 -->
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLine}"
                        Background="{StaticResource CardBg}" Padding="16,14,16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Foreground="{StaticResource TextMain}"
                                   FontSize="14" Text="기록 보관기간 (지나면 서버가 자동으로 지웁니다)" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 잠금 · 해제 · 일시사용 : 3년 — 근로기준법 제42조(근로시간 기록 보존)" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 사전알림 · 오프라인 · 연결 : 90일 — 근로시간 근거가 아니므로 짧게 둡니다" />
                        <TextBlock Style="{StaticResource BodyText}" Text="· 퇴사하면 보존의무가 끝나는 대로 지웁니다" />
                    </StackPanel>
                </Border>

                <!-- 본인 열람권 -->
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#BFDBFE"
                        Background="#EFF6FF" Padding="16,14,16,14" Margin="0,12,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Foreground="#1D4ED8"
                                   FontSize="14" Text="내 기록은 내가 직접 볼 수 있습니다" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="근태관리 웹에 로그인해 [계정] → &quot;내 PC 연결&quot; 로 가면, 내 PC에서 일어난 잠금 · 해제 · 일시사용 기록을 직접 확인할 수 있습니다. 같은 화면에서 [연결 해제]도 할 수 있습니다." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,20">
            <Button Style="{StaticResource GhostButton}" Content="닫기" Click="CloseButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
