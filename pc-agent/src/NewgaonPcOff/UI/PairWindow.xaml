<Window x:Class="NewgaonPcOff.UI.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC-OFF"
        Width="470" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CardBg}"
        FontFamily="{StaticResource UiFont}"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 이 창은 두 가지 모습을 갖는다. 한 번에 하나만 보인다(코드의 ApplyMode).
          ① StatusPanel — 이미 연결된 상태. 작은 창으로 "지금 어떤 상태인지"만 보여준다.
          ② SetupPanel  — 아직 연결되지 않았거나 [다시 연결]을 누른 상태. 연결코드 입력 폼. -->
    <Grid Margin="24,22,24,22">

        <!-- ══════════ ① 상태 ══════════ -->
        <StackPanel x:Name="StatusPanel" Visibility="Collapsed">

            <TextBlock Style="{StaticResource TitleText}" Text="PC-OFF 연결 상태" />

            <!-- 연결 배지 -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Success}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusBadgeText" Text="연결됨" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource Success}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StatusWho" Style="{StaticResource BodyText}" Margin="17,2,0,0"
                       FontSize="14" Foreground="{StaticResource TextMain}" FontWeight="Bold" />

            <!-- 저장된 연결 정보 -->
            <Border Margin="0,16,0,0" CornerRadius="8" Background="{StaticResource PageBg}"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="1" Padding="16,13,16,13">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Style="{StaticResource LabelText}" Width="92" Margin="0" Text="이 컴퓨터" />
                        <TextBlock x:Name="ValDevice" Style="{StaticResource BodyText}" Foreground="{StaticResource TextMain}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Style="{StaticResource LabelText}" Width="92" Margin="0" Text="서버" />
                        <TextBlock x:Name="ValServer" Style="{StaticResource BodyText}" Foreground="{StaticResource TextMain}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LabelText}" Width="92" Margin="0" Text="연결한 때" />
                        <TextBlock x:Name="ValPairedAt" Style="{StaticResource BodyText}" Foreground="{StaticResource TextMain}" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderLine}" Margin="0,12,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Style="{StaticResource LabelText}" Width="92" Margin="0" Text="근무 기준" />
                        <TextBlock x:Name="ValRule" Style="{StaticResource BodyText}" Width="286"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextMain}" Text="-" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Style="{StaticResource LabelText}" Width="92" Margin="0" Text="잠금" />
                        <TextBlock x:Name="ValLock" Style="{StaticResource BodyText}" Width="286"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextMain}" Text="확인 중..." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LabelText}" Width="92" Margin="0" Text="마지막 확인" />
                        <TextBlock x:Name="ValCheckedAt" Style="{StaticResource BodyText}" Width="286"
                                   TextWrapping="Wrap" Text="-" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusNote" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <!-- ⚠️ 지금 단계(2-B) 한계를 밝히는 줄. **2-C(잠금화면)를 만들면 이 줄을 지운다.**
                  숨기면 "잠긴다고 표시되는데 안 잠긴다"는 오해가 생긴다(사규: 화면에 가짜 데이터 금지). -->
            <TextBlock x:Name="PendingNote" Style="{StaticResource BodyText}" Margin="0,12,0,0" FontSize="12"
                       Foreground="{StaticResource Warning}" FontWeight="Bold"
                       Text="※ 지금은 잠길 시각만 계산해 보여줍니다. 실제 화면 잠금은 다음 단계에서 켜집니다." />

            <Button x:Name="RecheckButton" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                    Content="서버 다시 확인" Click="RecheckButton_Click" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ReconnectButton" Style="{StaticResource GhostButton}" Content="다시 연결"
                        Click="ReconnectButton_Click" Margin="0,0,8,0" />
                <Button x:Name="ClearButton2" Style="{StaticResource GhostButton}" Content="연결 정보 지우기"
                        Click="ClearButton_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource GhostButton}" Content="닫기"
                        Click="CloseButton_Click" />
            </StackPanel>

            <!-- 닫아도 프로그램이 죽지 않는다는 사실을 알려준다.
                  없으면 직원은 [닫기]가 "프로그램 끄기"인 줄 알고 매번 트레이를 확인하게 된다. -->
            <TextBlock Style="{StaticResource BodyText}" Margin="0,14,0,0" FontSize="12"
                       Text="이 창을 닫거나 최소화해도 PC-OFF는 트레이(화면 오른쪽 아래)에서 계속 실행됩니다. 완전히 끄려면 트레이 아이콘을 오른쪽 클릭해 [종료]를 누르세요." />

            <TextBlock Margin="0,10,0,0">
                <Hyperlink Click="InfoLink_Click" Foreground="{StaticResource Primary}"
                           TextDecorations="Underline" FontSize="13">
                    이 프로그램이 수집하는 정보 보기
                </Hyperlink>
            </TextBlock>

        </StackPanel>

        <!-- ══════════ ② 연결 설정 ══════════ -->
        <StackPanel x:Name="SetupPanel">

            <TextBlock Style="{StaticResource TitleText}" Text="내 PC를 근태관리에 연결" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                       Text="근태관리 웹에서 [계정] → &quot;내 PC 연결&quot; → [연결코드 발급]을 누르면 6자리 숫자가 나옵니다. 그 숫자를 아래에 입력하세요. (코드는 5분간, 한 번만 쓸 수 있습니다)" />

            <!-- 근로자 고지로 가는 길. 첫 실행 때 자동으로 뜨는 창이 여기라서, 연결하기 전에 볼 수 있게 둔다. -->
            <TextBlock Margin="0,10,0,0">
                <Hyperlink Click="InfoLink_Click" Foreground="{StaticResource Primary}"
                           TextDecorations="Underline" FontSize="13" FontWeight="Bold">
                    이 프로그램이 무엇을 수집하고 무엇을 수집하지 않는지 보기
                </Hyperlink>
            </TextBlock>

            <!-- 이미 연결돼 있는데 [다시 연결]로 들어온 경우 -->
            <Border x:Name="PairedPanel" Visibility="Collapsed" Margin="0,14,0,0"
                    CornerRadius="8" Background="{StaticResource PageBg}"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="1" Padding="14,12,14,12">
                <StackPanel>
                    <TextBlock x:Name="PairedText" Style="{StaticResource BodyText}" Foreground="{StaticResource TextMain}" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                               Text="새 코드로 다시 연결하면 기존 연결이 이 코드로 바뀝니다." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource LabelText}" Margin="0,18,0,6" Text="근태관리 서버 주소" />
            <TextBox x:Name="ServerUrlBox" Style="{StaticResource InputBox}" MaxLength="200"
                     TextChanged="ServerUrlBox_TextChanged" />
            <TextBlock x:Name="InsecureNote" Style="{StaticResource BodyText}" Margin="0,6,0,0"
                       Foreground="{StaticResource Warning}" FontWeight="Bold" Visibility="Collapsed"
                       Text="⚠️ https 가 아닌 주소입니다. 같은 네트워크에서 연결 정보를 엿볼 수 있으니, 실제 사용 시에는 https 주소를 쓰세요." />

            <TextBlock Style="{StaticResource LabelText}" Margin="0,14,0,6" Text="이 컴퓨터 이름 (관리자 [PC관리] 화면에 표시됩니다)" />
            <TextBox x:Name="DeviceNameBox" Style="{StaticResource InputBox}" MaxLength="80" />

            <TextBlock Style="{StaticResource LabelText}" Margin="0,14,0,6" Text="연결코드 (숫자 6자리)" />
            <TextBox x:Name="CodeBox" Style="{StaticResource CodeInputBox}" MaxLength="6"
                     TextChanged="CodeBox_TextChanged" />

            <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                    Content="연결하기" Click="ConnectButton_Click" IsDefault="True" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BackToStatusButton" Style="{StaticResource GhostButton}" Visibility="Collapsed"
                        Content="취소" Click="BackToStatusButton_Click" Margin="0,0,8,0" />
                <Button x:Name="ClearButton" Style="{StaticResource GhostButton}" Visibility="Collapsed"
                        Content="이 PC에서 연결 정보 지우기" Click="ClearButton_Click" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Content="닫기"
                        Click="CloseButton_Click" />
            </StackPanel>

            <TextBlock Style="{StaticResource BodyText}" Margin="0,12,0,0" FontSize="12"
                       Text="이 창을 닫아도 PC-OFF는 트레이(화면 오른쪽 아래)에서 계속 실행됩니다." />

        </StackPanel>
    </Grid>
</Window>
