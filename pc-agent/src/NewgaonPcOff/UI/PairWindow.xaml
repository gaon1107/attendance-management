<Window x:Class="NewgaonPcOff.UI.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC-OFF 연결 설정"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CardBg}"
        FontFamily="{StaticResource UiFont}"
        Closing="Window_Closing">

    <StackPanel Margin="24,22,24,22">

        <TextBlock Style="{StaticResource TitleText}" Text="내 PC를 근태관리에 연결" />
        <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                   Text="근태관리 웹에서 [계정] → &quot;내 PC 연결&quot; → [연결코드 발급]을 누르면 6자리 숫자가 나옵니다. 그 숫자를 아래에 입력하세요. (코드는 5분간, 한 번만 쓸 수 있습니다)" />

        <!-- 근로자 고지로 가는 길. 첫 실행 때 자동으로 뜨는 창이 여기라서, 연결하기 전에 볼 수 있게 둔다. -->
        <TextBlock Margin="0,10,0,0">
            <Hyperlink Click="InfoLink_Click" Foreground="{StaticResource Primary}"
                       TextDecorations="Underline" FontSize="13" FontWeight="Bold">
                이 프로그램이 무엇을 수집하고 무엇을 수집하지 않는지 보기
            </Hyperlink>
        </TextBlock>

        <!-- 이미 연결돼 있을 때만 보이는 안내 -->
        <Border x:Name="PairedPanel" Visibility="Collapsed" Margin="0,14,0,0"
                CornerRadius="8" Background="{StaticResource PageBg}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="1" Padding="14,12,14,12">
            <StackPanel>
                <TextBlock x:Name="PairedText" Style="{StaticResource BodyText}" Foreground="{StaticResource TextMain}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Text="새 코드로 다시 연결하면 기존 연결이 이 코드로 바뀝니다." />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource LabelText}" Margin="0,18,0,6" Text="근태관리 서버 주소" />
        <TextBox x:Name="ServerUrlBox" Style="{StaticResource InputBox}" MaxLength="200"
                 TextChanged="ServerUrlBox_TextChanged" />
        <TextBlock x:Name="InsecureNote" Style="{StaticResource BodyText}" Margin="0,6,0,0"
                   Foreground="{StaticResource Warning}" FontWeight="Bold" Visibility="Collapsed"
                   Text="⚠️ https 가 아닌 주소입니다. 같은 네트워크에서 연결 정보를 엿볼 수 있으니, 실제 사용 시에는 https 주소를 쓰세요." />

        <TextBlock Style="{StaticResource LabelText}" Margin="0,14,0,6" Text="이 컴퓨터 이름 (관리자 [PC관리] 화면에 표시됩니다)" />
        <TextBox x:Name="DeviceNameBox" Style="{StaticResource InputBox}" MaxLength="80" />

        <TextBlock Style="{StaticResource LabelText}" Margin="0,14,0,6" Text="연결코드 (숫자 6자리)" />
        <TextBox x:Name="CodeBox" Style="{StaticResource CodeInputBox}" MaxLength="6"
                 TextChanged="CodeBox_TextChanged" />

        <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                   Visibility="Collapsed" />

        <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                Content="연결하기" Click="ConnectButton_Click" IsDefault="True" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ClearButton" Style="{StaticResource GhostButton}" Visibility="Collapsed"
                    Content="이 PC에서 연결 정보 지우기" Click="ClearButton_Click" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Content="닫기"
                    Click="CloseButton_Click" IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>
