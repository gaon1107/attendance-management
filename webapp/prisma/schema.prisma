// 근태관리 데이터 설계도 (walking skeleton 1단계)
// 지금은 로컬 SQLite. 나중에 서버 임대 시 Postgres 등으로 옮길 수 있음.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 회사 (테넌트) — 모든 데이터는 회사 단위로 격리한다.
model Company {
  id            String   @id @default(cuid())
  name          String
  createdAt     DateTime @default(now())
  users         User[]
  invites       Invite[]
  leaveRequests LeaveRequest[]
  announcements Announcement[]
  passwordResetRequests PasswordResetRequest[]
  departments   Department[]
  attendanceCorrections AttendanceCorrection[]
  // 사업장 위치(사무실 출근 GPS 확인용). 안 정하면 위치 확인은 건너뜀.
  officeLat     Float?
  officeLng     Float?
  officeRadiusM Int      @default(200) // 허용 반경(m)
  // 사업장 주소(위치 설정 화면 전용 — [회사정보]의 회사 주소와는 별개로 관리).
  officeAddress       String? // 도로명/지번 주소(주소 검색으로 채우거나 직접 입력)
  officeAddressDetail String? // 상세주소(동·층·호수 등)
  // 사내 네트워크 허용 IP(들). 쉼표로 구분. 앞부분 일치도 허용(예: "203.0.113." → 203.0.113.* 전체).
  officeIps     String?
  // 근무제·기준시간(지각/정상 판정 기준). 안 정하면 지각 판정은 건너뜀.
  workStartTime String?  // 표준 출근 기준시각 "HH:MM" (예: "09:00")
  workEndTime   String?  // 표준 퇴근 기준시각 "HH:MM" (예: "18:00")
  lateGraceMin  Int      @default(0) // 지각 유예(분). 기준시각 + 유예 이후 출근이면 지각.
  // 기준 일 근무시간(소정근로시간, 시간 단위). 하루 실근무가 이 시간을 넘으면 초과분을 연장근무로 집계. 기본 8시간.
  standardWorkHours Float @default(8)
  // ── 주 52시간 초과근무 알림(B-3). 이번 주(월~현재) 실근무 합계가 위험선을 넘으면 대시보드에 알림. ──
  // 켜짐이면 판정·표시. 5인 미만 사업장·특례업종은 끈다. (법정 상한 52h는 코드 고정 — 낮추면 더 엄격할 뿐 무해)
  overtimeAlertOn   Boolean @default(true)
  // 근접 경고선(주간 시간). 이 시간 이상이면 "근접" 경고(노랑), 52h 이상이면 "초과"(빨강). 기본 48시간.
  overtimeWarnHours Float   @default(48)
  // 회사 기본 근무요일(JS getDay 기준: 0=일 … 6=토) CSV. 기본 월~금. 이 요일에만 지각·결근 판정.
  workDays      String   @default("1,2,3,4,5")
  // 법정공휴일 자동 반영 스위치. 켜짐이면 전국 공휴일(Holiday 표)을 "쉬는 날"로 본다(지각·결근·연차 제외).
  // 공휴일에도 정상근무하는 업종(병원·서비스업)은 꺼둔다. 회사 수동 휴무일(CompanyHoliday)은 이 스위치와 무관하게 항상 적용.
  holidayAutoOn Boolean  @default(true)
  companyHolidays CompanyHoliday[]
  companyEvents CompanyEvent[]
  // 얼굴 인식 기준 크기(%) — 얼굴 폭이 화면 폭의 이 비율 이상이어야 출퇴근 인식·등록 통과.
  // 해상도가 아니라 "비율"이라 카메라마다 화질이 달라도 같은 의미. 멀리 든 사진(작은 얼굴) 부정 차단용.
  faceMinPercent Int     @default(30)
  // 밝기 게이트(얼굴 영역 평균 밝기 0~255). 이 값보다 어두우면 위조 판독을 보류(재검토 배지 안 붙임 — 저조도 진짜 얼굴 오탐 방지).
  // 0 = 꺼짐(기존 동작). 현장 실측으로 최저선을 정해 켠다(예: 80).
  faceMinBrightness Int  @default(0)
  // 본인 확인 재검토 기준(%) — 판독 "진짜 확률"이 이 값 미만이면 관리자 화면에 재검토 배지.
  // 출퇴근을 막는 값이 아님(조용한 표시). 운영하며 조정할 수 있게 관리자 [설정] 항목으로 둠.
  livenessPercent Int    @default(50)
  // ── 이상접속 알림 규칙(접속/보안 6단계). 관리자 [설정]에서 조정. 전부 기본값 있음 = 기존 회사도 즉시 동작. ──
  // 관리자가 이상 접속을 "확인함"한 시각. 대시보드 배지는 이 시각 이후 이상건만 센다.
  // null = 한 번도 확인 안 함(전 기간 카운트). 확인 후 새 이상이 생기면 배지가 다시 켜진다.
  securityCheckedAt DateTime?
  // [심야 로그인] 이 시간대의 로그인 성공을 이상으로 본다. 24시간 교대 회사는 꺼야 한다(전부 오탐).
  // ⚠️ 자정을 넘어간다(22~06): 시작 > 끝이면 "시작 이후 또는 끝 이전". 시작 = 끝은 저장 거부(하루 종일이 심야가 됨).
  alertNightOn    Boolean @default(true)
  alertNightStart Int     @default(22) // 0~23시
  alertNightEnd   Int     @default(6)  // 0~23시
  // [연속 로그인 실패] 같은 IP에서 하루에 이 횟수 이상 실패하면 이상으로 본다.
  alertFailOn     Boolean @default(true)
  alertFailCount  Int     @default(5)
  // ※ [차단 IP 재시도]는 토글이 없다 — 관리자가 직접 차단한 IP라 오탐이 0이고, 끌 이유가 없다.
  // ── 회사 상세정보(관리자 [회사정보] 화면에서 입력·수정). 전부 선택(없어도 무방). ──
  // 기본정보
  bizRegNo      String?  // 사업자등록번호 (예: 123-12-12345)
  corpRegNo     String?  // 법인등록번호
  ceoName       String?  // 대표자 이름
  bizType       String?  // 업태
  bizItem       String?  // 종목
  // 주소·연락처
  zipCode       String?  // 우편번호
  address       String?  // 주소(도로명/지번)
  addressDetail String?  // 상세주소
  companyPhone  String?  // 대표전화
  companyFax    String?  // 팩스
  companyEmail  String?  // 대표 이메일
  website       String?  // 홈페이지
  // 담당자(근태 담당)
  managerName   String?  // 주 담당자 이름
  managerTitle  String?  // 직책
  managerPhone  String?  // 담당 연락처
  managerEmail  String?  // 담당 이메일
  // 기타
  companyNote   String?  // 비고
  // 회사 로고 — 사이드바 상단에 표시(없으면 "근" 글자). 실제 이미지는 storage/company-docs/{id}/ 에 저장, 파일명만 보관.
  logoName      String?
  documents     CompanyDocument[]
  // ── 교대근무(시프트). shiftMode=null이면 교대 안 함(현행 동작). scheduleType: fixed(요일패턴)|rotation(순환). ──
  shiftMode     Int?      // null=안 함, 2=2교대, 3=3교대
  scheduleType  String?   // "fixed" | "rotation"
  shifts        Shift[]
  rotationRule  RotationRule?
  // ── 결재선(다단계 승인). approvalMode=single이면 기존 단일 관리자 승인(현행 동작). ──
  // deptline이면 부서장 자동 결재선: 신청이 소속 부서장→상위 부서장 순으로 approvalStepCount 단계만큼 타고 올라간다.
  // 부서장 미지정 부서는 관리자 폴백. 원본 신청 status는 전 단계 승인 시에만 approved로 바뀐다(그전엔 pending=미승인).
  approvalMode      String  @default("single") // "single"(기존) | "deptline"(결재선)
  approvalStepCount Int     @default(1)         // 결재 단계 수(1~2 권장, 최대 3 방어)
  approvalSteps     ApprovalStep[]
}

// 회사 첨부문서 — 사업자등록증·통장사본 등. 종류(kind)별 최신 1건만 유지(재업로드 시 이전 파일 교체·삭제).
// ※ 보호: 실제 파일은 웹 공개경로 밖(storage/company-docs/)에 저장하고, 관리자만 인증 라우트로 다운로드한다.
model CompanyDocument {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  kind         String   // "bizReg"(사업자등록증) | "seal"(인감스캔본) | "bankbook"(통장사본) | "factory"(공장등록증) | "etc"(기타)
  originalName String   // 사용자가 올린 원래 파일명(표시용)
  storedName   String   // storage/company-docs/{companyId}/ 안의 실제 저장 파일명
  mimeType     String   // application/pdf | image/jpeg | image/png
  size         Int      // 바이트
  uploadedBy   String   // 업로드한 관리자 이름(스냅샷)
  uploadedAt   DateTime @default(now())

  // 회사·종류당 1건만 — 동시 업로드 시 중복 레코드 방지(upsert의 기준 키).
  @@unique([companyId, kind])
}

// 사용자 — 관리자(admin) 또는 직원(employee). 반드시 한 회사에 속한다.
model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  email        String    @unique
  passwordHash String // 비밀번호 원문은 저장하지 않음(암호화 해시만)
  name         String
  role         String    @default("admin") // "admin" | "employee"
  createdAt    DateTime  @default(now())
  sessions     Session[]
  attendances  Attendance[]
  leaveRequests LeaveRequest[]
  passwordResetRequests PasswordResetRequest[]
  // 출퇴근 인증방식: "face"(얼굴) | "gps"(GPS/위치). null=아직 선택 안 함. 얼굴은 강제 아님, 언제든 변경 가능.
  authMethod     String?
  // 생체정보(얼굴) 이용 동의 시각. 동의 철회 시 null로 되돌린다.
  faceConsentAt  DateTime?
  // 얼굴서버(GaonFR)에 얼굴 등록을 완료한 시각(마지막). null=미등록. 등록/철회 시 갱신.
  // ※ 얼굴 원본·특징값은 우리 DB에 저장하지 않는다(얼굴서버에만). 여긴 "등록했다"는 참조 표시만.
  faceEnrolledAt DateTime?
  // 얼굴 등록 횟수(각도를 다르게 최대 3회). 여러 각도로 등록하면 인식 정확도가 올라간다. 삭제 시 0으로.
  faceEnrollCount Int @default(0)
  // 직원별 근무요일 예외(CSV). null이면 회사 기본(Company.workDays)을 따른다.
  workDays       String?
  // ── 교대근무: 순환(rotation) 방식일 때 소속 조. fixed·비교대면 미사용(null). ──
  shiftGroupId   String?
  shiftGroup     ShiftGroup?    @relation(fields: [shiftGroupId], references: [id])
  shiftPatterns  ShiftPattern[]
  // 로그인 무차별 대입(비번 찍기) 방어: 연속 실패 횟수 + 잠금 해제 시각.
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  // 퇴사(비활성화) 시각. null이면 재직중. 값이 있으면 로그인 불가·집계 제외(단, 과거 근태 기록은 보존).
  deactivatedAt    DateTime?
  // [레거시] 예전 수동 부여 일수. B-2 자동발생 도입 후로는 직접 읽지 않는다(annualLeaveGranted 헬퍼가 대체).
  annualLeaveDays  Float     @default(15)
  // B-2 연차 자동발생: 관리자 수동조정(override). null=입사일 기준 자동계산, 값=그 값 사용(특별부여/감액).
  annualLeaveOverride Float?
  // 임시 비밀번호로 로그인한 경우 true → 로그인 직후 새 비밀번호를 정하도록 강제한다. 변경하면 false로 되돌린다.
  mustChangePassword Boolean @default(false)
  // 소속 부서(선택). null이면 부서 미배정. 부서가 삭제되면 소속 직원은 자동으로 null(미배정)이 된다.
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  // 인적정보(선택) — 초대 가입 때 직원이 입력하거나, 관리자가 직원 상세에서 입력·수정한다. 없어도 무방.
  phone          String?   // 전화번호(연락처)
  position       String?   // 직급/직책 (예: 사원·대리·과장·부장)
  employeeNo     String?   // 사번(사원번호) — 회사 내부 고유번호. 현재 중복검사 없음(단순 저장).
  hireDate       DateTime? // 입사일 (자동 기록되는 가입일 createdAt과는 별개)
  attendanceCorrections AttendanceCorrection[]
  // 공지(알림)를 마지막으로 확인한 시각. 이 시각 이후 올라온 공지는 "새 알림(NEW)"으로 본다.
  noticesSeenAt  DateTime?
  // 첫 사용 안내(온보딩 투어)를 본 시각. 값이 있으면 다시 띄우지 않는다.
  tourSeenAt     DateTime?
}

// 출퇴근 기록 — 출근 1건마다 한 줄. 퇴근 전에는 clockOut이 비어있음(null).
model Attendance {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  companyId String // 회사 단위 격리·조회용
  clockIn   DateTime  @default(now())
  clockOut  DateTime? // 퇴근 시각(퇴근 전엔 null)
  createdAt DateTime  @default(now())
  breaks    Break[]
  // 근무형태: "office"(사무실) | "home"(재택) | "field"(외근)
  workMode  String    @default("office")
  // 위치 확인 결과(사무실만 의미 있음): "verified"(확인됨) | "out_of_range"(벗어남) | "unavailable"(확인 불가) | null(재택/외근=해당없음)
  // ※ 프라이버시: GPS 원본 좌표는 저장하지 않고 결과만 남긴다.
  locationStatus String?
  // 얼굴 출퇴근 시 촬영 사진·판독 기록(출근/퇴근 각 1건). GPS/일반 출퇴근은 없음.
  clockPhotos ClockPhoto[]
}

// 출퇴근 촬영 사진 + 위조 판독(라이브니스) 기록 — 얼굴 출퇴근 1회당 1건.
// 판독은 관리자 확인용일 뿐, 출퇴근 성공/실패에 관여하지 않는다(차단 없음).
// ※ 생체정보 보호: 사진 파일은 AES-256 암호화해 웹 공개경로 밖에 저장, 관리자만 열람(열람 기록), 90일 후 자동 파기.
//    동의 화면(consent)에 "출퇴근 사진 90일 보관" 항목 포함 — 확정 2026-07-11.
model ClockPhoto {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
  companyId    String // 회사 격리·조회용
  userId       String // 조회 편의(본인 표시 없음 — 관리자 화면 전용)
  kind         String // "in"(출근) | "out"(퇴근)
  // 판독 상태: "ok"(기준값 이상) | "suspect"(기준값 미만 → "본인 확인 재검토 필요" 배지) | "error"(판독 실패, 사진만 보관)
  livenessStatus String
  livenessScore  Float? // 진짜 확률 0~1 (error면 null)
  // 암호화된 사진 파일 이름(storage/clock-photos/ 안). 파기되면 파일만 지우고 이 행은 fileDeletedAt 표시.
  fileName     String
  fileDeletedAt DateTime? // 90일 자동 파기 시각(파기 후에도 점수·판독 기록은 남는다)
  // 관리자 열람 기록(최근 1건): 누가 언제 열람했는지. 상세 감사가 필요해지면 별도 테이블로 확장.
  lastViewedBy String?
  lastViewedAt DateTime?
  createdAt    DateTime   @default(now())

  @@index([companyId, createdAt])
  @@index([attendanceId])
}

// 외출 기록 — 출근한 상태에서 외출할 때마다 한 줄. 복귀 전에는 endAt이 비어있음(null).
// 실근무시간 = (퇴근-출근) - 외출시간 합.
model Break {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
  reason       String // 식사 | 외근 | 개인용무 | 기타
  startAt      DateTime   @default(now())
  endAt        DateTime? // 복귀 시각(복귀 전엔 null)
  createdAt    DateTime   @default(now())
}

// 직원 초대 — 관리자가 만든 초대 링크. 직원이 이 링크로 스스로 가입(비밀번호 직접 설정)한다.
model Invite {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  token     String    @unique // 링크에 들어가는 비밀 값
  createdAt DateTime  @default(now())
  expiresAt DateTime // 이 시각 이후엔 사용 불가(기본 7일)
  usedAt    DateTime? // 사용된 시각(가입 완료). null이면 아직 미사용.
}

// 휴가 신청 — 직원이 신청하고 관리자가 승인/반려한다.
// 승인된 휴가일은 결근/미출근이 아니라 "휴가"로 처리된다.
model LeaveRequest {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  // 종류: annual(연차) | half_am·half_pm(반차 0.5일) | early_leave(조퇴) | sick(병가) |
  //       family_event(경조휴가) | official(공가) | special(특별휴가) | half(레거시 반차).
  //       sick·조퇴·경조·공가·특별은 연차 차감 없음(deducts=false). 정의·차감·면제는 lib/leave.ts가 단일 출처.
  type       String
  startDate  DateTime  // 시작일(자정 기준). 반차·병가 단일일은 start==end.
  endDate    DateTime  // 종료일(자정 기준, 포함)
  days       Float     // 사용 일수(신청 시 근무요일 기준으로 계산해 저장). 연차/반차만 잔여에서 차감.
  reason     String?
  // 상태: "pending"(대기) | "approved"(승인) | "rejected"(반려)
  status     String    @default("pending")
  decidedAt  DateTime? // 승인/반려 처리 시각
  // 결재선 2차: 결재자 결정 사유·처리자. add-only(nullable) — 기존 행·판정 로직 무영향.
  // single 모드는 여기 직접 저장, deptline 모드는 단계별 ApprovalStep.comment + 최종 결정을 여기 미러.
  decisionComment String? // 승인/반려 사유(선택 저장). 신청자에게 표시.
  decidedById     String? // 처리한 결재자/관리자 userId(표시용, 관계 없이 id만 보관)
  createdAt  DateTime  @default(now())
}

// 사내 공지사항 — 관리자가 작성하고 모든 직원이 열람한다.
model Announcement {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  title      String
  body       String
  authorName String   // 작성 시점의 관리자 이름(스냅샷)
  createdAt  DateTime @default(now())
  // 캘린더에 표시할 날짜("YYYY-MM-DD"). null이면 작성일(createdAt)에 표시(기존 공지 호환).
  // 관리자가 공지 작성 시 원하는 날짜를 지정할 수 있다. 표시 위치 전용(작성 시각과 별개).
  noticeDate String?
}

// 근태 정정 요청 — 직원이 특정 날짜의 출퇴근을 고쳐달라고 요청하고, 관리자가 승인/반려한다.
// 승인하면 그 날의 출퇴근 기록(Attendance)에 실제로 반영된다. (실근무시간 재계산)
model AttendanceCorrection {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  targetDate   DateTime  // 정정 대상 날짜(자정 기준)
  requestedIn  String?   // 요청 출근 시각 "HH:MM" (비우면 출근은 그대로)
  requestedOut String?   // 요청 퇴근 시각 "HH:MM" (비우면 퇴근은 그대로)
  reason       String    // 정정 사유(필수)
  // 상태: "pending"(대기) | "approved"(승인·반영됨) | "rejected"(반려)
  status       String    @default("pending")
  decidedAt    DateTime?
  // 결재선 2차: 결재자 결정 사유·처리자. add-only(nullable) — 기존 행·반영 로직 무영향.
  decisionComment String? // 승인/반려 사유(선택 저장). 신청자에게 표시.
  decidedById     String? // 처리한 결재자/관리자 userId(표시용, 관계 없이 id만 보관)
  createdAt    DateTime  @default(now())
}

// 결재 단계 — 다단계 승인(부서장 결재선)의 각 단계·진행상태.
// 원본 신청(LeaveRequest/AttendanceCorrection)은 스키마 무변경 — 다형 참조(requestType+requestId)로 연결한다.
// approvalMode=deptline 회사만 생성한다. single 회사는 이 표를 쓰지 않고 기존 단일 승인 경로 그대로.
model ApprovalStep {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  requestType    String    // "leave"(휴가) | "correction"(근태정정)
  requestId      String    // LeaveRequest.id 또는 AttendanceCorrection.id
  stepOrder      Int       // 1,2,3… 순서
  approverUserId String    // 이 단계 결재자(부서장/대결자/관리자)
  // 상태: "pending"(대기) | "approved"(승인) | "rejected"(반려) | "skipped"(건너뜀=본인 결재 등)
  status         String    @default("pending")
  decidedAt      DateTime?
  comment        String?   // 승인/반려 사유(선택)
  createdAt      DateTime  @default(now())

  @@index([companyId, requestType, requestId]) // 한 신청의 단계들 조회
  @@index([approverUserId, status])            // 결재함(내 차례) 조회
}

// 부서 — 회사 안의 조직 단위. 관리자가 만들고, 직원을 부서에 배정한다.
model Department {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())
  users     User[]
  // ── 결재선(부서장 자동 결재선)용. 전부 선택 — 안 정하면 이 부서는 결재선에서 관리자 폴백. ──
  // 관계 없이 id만 보관(add-only, User·자기참조 무변경). 결재자 해석은 lib/approval.ts + 조회로 처리.
  headUserId   String?  // 부서장(직원 1명). 이 부서 소속 신청의 1차 결재자.
  parentId     String?  // 상위부서 id(부서 계층). null=최상위. 결재선이 위로 타고 올라갈 대상.
  deputyUserId String?  // 대결자(부서장 부재 시 대리결재). 선택.
}

// 비밀번호 재설정 요청 — 직원이 로그인 화면에서 "비밀번호 찾기"로 접수한다.
// 관리자가 확인 후 임시 비밀번호를 발급하면 status가 "resolved"로 바뀐다.
// ※ 이메일 존재 여부 노출 방지: 실제로 있는 계정에 대해서만 요청이 만들어진다.
model PasswordResetRequest {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  // 상태: "pending"(대기) | "resolved"(임시 비밀번호 발급 완료)
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime? // 관리자가 임시 비밀번호를 발급한 시각
}

// 로그인 세션 — 로그인 시 발급하는 "출입증(토큰)". 브라우저 쿠키에 토큰만 담는다.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// 접속·보안 이벤트 로그 — 로그인/로그아웃/출퇴근/관리자 동작의 "누가·언제·어디서(IP·기기)·결과" 기록.
// ※ 감사 로그 원칙: 직원이 삭제·비활성화돼도 기록은 남아야 하므로 User와 외래키로 묶지 않고
//    userId·actorName(이름 스냅샷)을 값으로만 저장한다(CompanyDocument.uploadedBy와 동일 방식).
// ※ 개인정보(IP·기기)라 보관기간을 정해 오래된 것은 자동 파기한다(정책은 조회/파기 로직에서 관리).
model AccessEvent {
  id         String   @id @default(cuid())
  // 회사 격리용. 로그인 실패 중 "존재하지 않는 이메일"은 소속 회사를 알 수 없어 null이 될 수 있다(회사별 화면엔 안 보임).
  companyId  String?
  userId     String?  // 행위자 계정 id(있으면). 비로그인 시도·미상 계정은 null.
  actorName  String?  // 행위자 이름 스냅샷(삭제돼도 표시). 미상이면 null.
  emailTried String?  // 로그인 시도에 쓰인 이메일(실패 분석용).
  // 동작 종류: "login"(로그인 성공) | "login_fail"(로그인 실패) | "logout"(로그아웃)
  //          | "clock_in"/"clock_out"(출퇴근) | "config"(설정 변경) | "purge"(생체정보 파기)
  //          | "data_view"(민감 데이터 조회) | "blocked"(차단 IP에 의해 거부) 등. 화면에서 이 값으로 필터.
  kind       String
  // 결과: "success" | "fail" | "blocked"
  result     String
  ip         String?  // 접속 IP(개발 PC는 127.0.0.1). 프록시 뒤 운영에서만 진짜 외부 IP.
  userAgent  String?  // 원본 User-Agent(감사·추후 분석용).
  device     String?  // 표시용 기기 라벨(예: "iPhone" · "Windows PC"). userAgent에서 파생.
  // 부가정보(평문 짧은 라벨). 예: "bad_credentials"(로그인 실패 사유) · "office"(출퇴근 근무형태)
  //   · "office_network"(바뀐 설정 이름) · "admin_revoke:홍길동 (계정 xxx)"(파기 대상).
  // ⚠️ 설정 "값"·비밀값은 넣지 않는다(로그가 유출 통로가 됨). 표시 라벨은 lib/access-labels.ts.
  meta       String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([kind])
  // 파기 전용 색인 — 파기 쿼리는 where: { createdAt: { lt: cutoff } }로 companyId가 없어
  // 위 복합 색인(선두 컬럼=companyId)을 타지 못하고 풀스캔이 된다. 2년치가 쌓인 뒤 첫 파기 때
  // 대량 삭제가 길게 잠기는 것을 막기 위해 createdAt 단독 색인을 둔다.
  @@index([createdAt])
}

// 차단 IP — 관리자가 명단에 올린 IP는 로그인을 거부한다(접속/보안 5단계).
// ※ 유효기간 없음 = 관리자가 [해제]할 때까지 유지(사장님 결정 2026-07-16).
//    자동 해제를 두면 "풀린 줄 모르는" 상태가 생겨 더 위험하다. 해제는 목록에서 버튼 한 번.
// ※ 자기잠금 방어는 lib/ip-block.ts(사내망 우선 통과) + 추가 시 현재 IP 검사(actions/ip-block.ts)가 담당.
//    회사 허용 IP(Company.officeIps)는 여기 뭘 넣든 **항상 이긴다**.
// ※ 감사 로그 원칙: 만든 관리자가 삭제돼도 남도록 User와 외래키로 묶지 않고 이름 스냅샷만 저장.
model BlockedIp {
  id        String   @id @default(cuid())
  companyId String // 회사 격리 — 차단은 회사별 정책이다
  // 차단 대상: 정확한 IP("1.2.3.4") 또는 대역("1.2.3" = 1.2.3.* 전체). 판정은 lib/ip.ts의 ipMatches 재사용.
  pattern   String
  reason    String? // 왜 막았는지(관리자 메모)
  createdBy String? // 막은 관리자 이름 스냅샷(계정이 지워져도 감사 추적 가능)
  createdAt DateTime @default(now())

  @@index([companyId])
}

// 전국 법정공휴일 — 공공데이터포털(한국천문연구원 특일정보 API)에서 수집해 저장.
// ※ 공휴일은 전국 동일하므로 회사와 무관하게 1벌만 공유한다(회사별 적용 여부는 Company.holidayAutoOn).
// ※ 화면은 이 저장분을 읽어 판정한다(정부 API를 매 요청마다 부르지 않음 = 장애 무관·빠름).
model Holiday {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD" (KST). 대체공휴일도 각각 한 줄.
  name      String   // 공휴일 이름(예: "광복절", "설날")
  year      Int      // 조회·갱신 편의(연 단위 재수집)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([year])
}

// 회사 수동 휴무일 — 관리자가 직접 지정한 쉬는 날(창립기념일·임시공휴일 즉시 반영 등).
// ※ Company.holidayAutoOn 스위치와 무관하게 항상 "쉬는 날"로 적용된다.
model CompanyHoliday {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  date      String   // "YYYY-MM-DD"
  name      String   // 휴무일 이름(예: "창립기념일")
  createdBy String?  // 등록한 관리자 이름 스냅샷
  createdAt DateTime @default(now())

  // 회사·날짜당 1건만(같은 날 중복 등록 방지)
  @@unique([companyId, date])
  @@index([companyId])
}

// 일정 — [일정] 캘린더에서 날짜에 등록하는 메모/이벤트(예: "월례회의", "출하").
// ※ 표시 전용 — 지각·결근·연차 등 근태 판정에는 영향을 주지 않는다(휴무일은 CompanyHoliday가 담당).
// ※ userId 로 "회사 일정"과 "개인 일정"을 구분한다:
//    · userId = null  → 회사 일정(관리자 등록, 전 직원 공용, 관리자만 편집)
//    · userId = 값     → 개인 일정(그 직원 본인만 보고·편집. 프라이버시상 타인에게 노출 안 함)
//    ※ User와 외래키로 묶지 않고 값만 저장(AccessEvent와 동일 — 계정이 지워져도 조회 로직 단순).
model CompanyEvent {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?  // null=회사 일정 / 값=개인 일정 소유자
  date      String   // "YYYY-MM-DD" (하루짜리)
  title     String   // 일정 내용(표시 전용)
  color     String?  // 막대 색(선택, 없으면 기본색)
  createdBy String?  // 등록한 사람 이름 스냅샷
  createdAt DateTime @default(now())

  @@index([companyId, date])
  @@index([userId])
}

// 문자(아이원24) 발송 기록 — 초대·임시비번 문자의 발송 이력(A-2).
//  · 용도 ①1회 제한(같은 초대/요청 중복발송 차단) ②회사별 발송량·비용 파악 근거 ③감사.
//  · User/Company와 외래키로 묶지 않고 값만 저장(AccessEvent와 동일 — 계정 삭제와 무관하게 기록 보존).
//  · ⚠️ 임시비밀번호 등 민감 본문은 저장하지 않는다(발송 사실·수신번호·성공여부·실패사유만).
model SmsLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?  // 임시비번=대상 직원 / 초대=null
  kind      String   // "invite" | "temp_password"
  refId     String?  // inviteId 또는 passwordResetRequestId (1회 제한 조회용)
  toNumber  String   // 수신번호(숫자만)
  result    String   // "success" | "fail"
  detail    String?  // 실패 사유 등 (비밀 본문 저장 금지)
  createdAt DateTime @default(now())

  // 1회 제한을 DB에서 원자적으로 보장(동시 클릭 이중발송·이중과금 차단).
  //  · 발송 성공/진행중(pending)은 이 조합으로 1건만 존재 가능.
  //  · 발송 실패 시엔 액션이 refId를 null로 바꿔 슬롯을 풀어 재시도를 허용한다(실패=과금 없음).
  @@unique([companyId, kind, refId])
  @@index([companyId, createdAt]) // 회사별 발송량/기간 조회
}

// ── 교대근무(시프트) — 상세는 docs/04_architecture/교대근무_설계.md ──
// 조별 근무시간 정의(회사당 shiftMode개). endTime<=startTime 이면 익일(야간조).
model Shift {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  order     Int     // 1,2,3 (표시·순환 순서 기준)
  name      String? // "오전조" 등(선택)
  startTime String  // "HH:MM"
  endTime   String  // "HH:MM"
  @@unique([companyId, order])
}

// [fixed] 요일 패턴(직원×요일→조). shiftId=null=휴무.
model ShiftPattern {
  id        String  @id @default(cuid())
  companyId String
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  dayOfWeek Int     // 0=일 … 6=토
  shiftId   String?
  @@unique([userId, dayOfWeek])
}

// [rotation] 조(A/B/C). order=0,1,2 = 시작단계 offset.
model ShiftGroup {
  id        String  @id @default(cuid())
  companyId String
  order     Int
  name      String?
  users     User[]
  @@unique([companyId, order])
}

// [rotation] 순환 규칙(회사당 1).
model RotationRule {
  companyId  String  @id
  company    Company @relation(fields: [companyId], references: [id])
  orderCsv   String  // 순환 순서(shift.order들), 예 "1,2,3"
  unit       String  // "day" | "week" | "month"
  anchorDate String  // "YYYY-MM-DD"
}

// 예외(덮어쓰기) — 관리자/직원 수정. 그날만 기본배정을 덮는다.
model ShiftAssignment {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  date      String   // "YYYY-MM-DD"
  shiftId   String?  // null=휴무
  editedBy  String   // "admin" | "self"
  createdAt DateTime @default(now())
  @@unique([userId, date])
  @@index([companyId, date])
}

// 근무표 변경 이력(감사) — 셀프수정 추적·되돌리기 근거.
model ShiftChangeLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String   // 대상 직원
  date      String
  fromLabel String?  // 변경 전 조 라벨
  toLabel   String?  // 변경 후 조 라벨
  actor     String   // "admin" | "self"
  actorId   String   // 수정 실행자 userId
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}
