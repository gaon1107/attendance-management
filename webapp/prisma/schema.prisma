// 근태관리 데이터 설계도 (walking skeleton 1단계)
// 지금은 로컬 SQLite. 나중에 서버 임대 시 Postgres 등으로 옮길 수 있음.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 회사 (테넌트) — 모든 데이터는 회사 단위로 격리한다.
model Company {
  id            String   @id @default(cuid())
  name          String
  createdAt     DateTime @default(now())
  users         User[]
  invites       Invite[]
  // 사업장 위치(사무실 출근 GPS 확인용). 안 정하면 위치 확인은 건너뜀.
  officeLat     Float?
  officeLng     Float?
  officeRadiusM Int      @default(200) // 허용 반경(m)
  // 사내 네트워크 허용 IP(들). 쉼표로 구분. 앞부분 일치도 허용(예: "203.0.113." → 203.0.113.* 전체).
  officeIps     String?
  // 근무제·기준시간(지각/정상 판정 기준). 안 정하면 지각 판정은 건너뜀.
  workStartTime String?  // 표준 출근 기준시각 "HH:MM" (예: "09:00")
  workEndTime   String?  // 표준 퇴근 기준시각 "HH:MM" (예: "18:00")
  lateGraceMin  Int      @default(0) // 지각 유예(분). 기준시각 + 유예 이후 출근이면 지각.
  // 회사 기본 근무요일(JS getDay 기준: 0=일 … 6=토) CSV. 기본 월~금. 이 요일에만 지각·결근 판정.
  workDays      String   @default("1,2,3,4,5")
}

// 사용자 — 관리자(admin) 또는 직원(employee). 반드시 한 회사에 속한다.
model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  email        String    @unique
  passwordHash String // 비밀번호 원문은 저장하지 않음(암호화 해시만)
  name         String
  role         String    @default("admin") // "admin" | "employee"
  createdAt    DateTime  @default(now())
  sessions     Session[]
  attendances  Attendance[]
  // 출퇴근 인증방식: "face"(얼굴) | "gps"(GPS/위치). null=아직 선택 안 함. 얼굴은 강제 아님, 언제든 변경 가능.
  authMethod     String?
  // 생체정보(얼굴) 이용 동의 시각. 동의 철회 시 null로 되돌린다.
  faceConsentAt  DateTime?
  // 직원별 근무요일 예외(CSV). null이면 회사 기본(Company.workDays)을 따른다.
  workDays       String?
  // 로그인 무차별 대입(비번 찍기) 방어: 연속 실패 횟수 + 잠금 해제 시각.
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  // 퇴사(비활성화) 시각. null이면 재직중. 값이 있으면 로그인 불가·집계 제외(단, 과거 근태 기록은 보존).
  deactivatedAt    DateTime?
}

// 출퇴근 기록 — 출근 1건마다 한 줄. 퇴근 전에는 clockOut이 비어있음(null).
model Attendance {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  companyId String // 회사 단위 격리·조회용
  clockIn   DateTime  @default(now())
  clockOut  DateTime? // 퇴근 시각(퇴근 전엔 null)
  createdAt DateTime  @default(now())
  breaks    Break[]
  // 근무형태: "office"(사무실) | "home"(재택) | "field"(외근)
  workMode  String    @default("office")
  // 위치 확인 결과(사무실만 의미 있음): "verified"(확인됨) | "out_of_range"(벗어남) | "unavailable"(확인 불가) | null(재택/외근=해당없음)
  // ※ 프라이버시: GPS 원본 좌표는 저장하지 않고 결과만 남긴다.
  locationStatus String?
}

// 외출 기록 — 출근한 상태에서 외출할 때마다 한 줄. 복귀 전에는 endAt이 비어있음(null).
// 실근무시간 = (퇴근-출근) - 외출시간 합.
model Break {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
  reason       String // 식사 | 외근 | 개인용무 | 기타
  startAt      DateTime   @default(now())
  endAt        DateTime? // 복귀 시각(복귀 전엔 null)
  createdAt    DateTime   @default(now())
}

// 직원 초대 — 관리자가 만든 초대 링크. 직원이 이 링크로 스스로 가입(비밀번호 직접 설정)한다.
model Invite {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  token     String    @unique // 링크에 들어가는 비밀 값
  createdAt DateTime  @default(now())
  expiresAt DateTime // 이 시각 이후엔 사용 불가(기본 7일)
  usedAt    DateTime? // 사용된 시각(가입 완료). null이면 아직 미사용.
}

// 로그인 세션 — 로그인 시 발급하는 "출입증(토큰)". 브라우저 쿠키에 토큰만 담는다.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}
