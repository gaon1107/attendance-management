# 근태관리 운영 설정값 목록표 (2026-11-18, 운영 준비 2단계)
#
# 쓰는 법: 서버에서 이 파일을 webapp/.env.production 으로 복사한 뒤 값을 채운다.
#   ⛔ 값이 든 .env.production 은 깃에 올리지 않는다(.gitignore). 이 목록표에는 값을 절대 적지 않는다.
#   ⛔ 개발 PC의 webapp/.env 값을 그대로 옮기지 않는다 — 특히 CLOCK_PHOTO_KEY 는 서버에서 새로 만든다.
#   ⚠️ 값에 `$` 가 들어 있으면 반드시 작은따옴표로 감싼다. 예: FACE_CLIENT_SECRET='ab$cd12'
#      (감싸지 않으면 Docker가 `$cd` 부분을 조용히 지워 버려, 원인 모를 인증 실패가 난다)
#
# Docker 상자가 스스로 정하는 값(여기 적지 않음): DATABASE_URL, CLOCK_PHOTO_DIR, COMPANY_DOC_DIR,
#   REQUEST_ATTACHMENT_DIR, NODE_ENV, TZ, PORT  → webapp/Dockerfile 참고

# ── 반드시 ────────────────────────────────────────────────────────────
# 출퇴근 사진 암호화 키(64자리 16진수). 만들기: openssl rand -hex 32
#   🔴 잃어버리면 저장된 출퇴근 사진을 영원히 못 연다 → 만든 즉시 안전한 곳(비밀번호 관리 도구)에 따로 보관
CLOCK_PHOTO_KEY=

# 앞단 nginx(HTTPS)를 세운 뒤에만 1. 켜면 사무실 IP 출근 인증·IP 차단·접속기록 IP가 살아난다.
#   ⚠️ nginx 없이 1로 두면 접속자가 IP를 마음대로 속일 수 있다(체크리스트 3번)
TRUST_PROXY=1

# ── 얼굴인증 (5단계 운영 전환 때 채움. 비워 두면 얼굴 기능만 꺼지고 GPS 출퇴근은 정상) ────────
# 반드시 https:// 로 시작(아니면 얼굴 기능이 막힌다, 보안검수 M9)
FACE_API_BASE_URL=
FACE_CLIENT_ID=
FACE_CLIENT_SECRET=
FACE_LICENSE_KEY=
# 위조 판독 예비 기준값(회사별 [설정]값이 우선). 개발과 같은 0.5 권장
LIVENESS_THRESHOLD=0.5

# ── 공공·외부 서비스 (없으면 해당 기능만 비활성, 나머지는 정상) ───────────────
# 공휴일(공공데이터포털 특일정보)
HOLIDAY_API_KEY=
# 회원가입 사업자등록 상태 확인(국세청, 공공데이터포털) — 없으면 "확인 보류"로 가입은 진행
BIZREG_API_KEY=
# 사무실 주소 → 좌표 변환(카카오 로컬 REST 키)
KAKAO_REST_KEY=

# ── 문자(비즈모아샷) — **가온 계정 = 회사 계정(회사 관리자) 인증 문자 전용**(복구 번호 확인·비밀번호 찾기·번호 변경 통지) ──
#   · 2026-11-21 사장님 확정: 직원 비밀번호 찾기·공지·초대·임시비번·알림톡은 각 회사의 비즈모아샷 계정으로만(가온 대체 발송 없음).
#   · 아래 MOASHOT_SEND_URL은 회사 계정 발송에도 같이 쓴다(없으면 회사 문자도 안 나간다).
#   · 4개가 모두 있어야 켜진다. 하나라도 비면 문자 기능 전체가 꺼진다(비밀번호 찾기는 관리자 승인 방식만 보임).
#   · 발신번호는 비즈모아샷에 **사전등록된 번호**여야 한다(서비스 관리 > 발신번호 사전등록).
#   · 발송 주소는 https만 된다(비밀번호를 싣고 가므로). 아래 값 그대로 넣는다.
#   · 상한: 전체 1시간 100·하루 500 / 회사당 30·100 (lib/sms.ts). 넘으면 잠시 멈춘다.
# MOASHOT_ID=
# MOASHOT_PW=
# MOASHOT_SENDER=
# MOASHOT_SEND_URL=https://biz.moashot.com/EXT/URLASP/mssendUTF.asp

# ── 회사별 문자 계정 비밀번호 암호화 열쇠 (2026-11-21, 메시지 관리 1단계 — lib/sms-crypto.ts) ──
#   · 회사들이 [설정 → 문자·알림톡]에 넣은 비즈모아샷 비밀번호를 이 열쇠로 암호화해 저장한다. 없으면 저장을 거부한다.
#   · 32바이트 16진수 64자. 서버에서 만든다: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   · 🔴 잃어버리면 저장된 비밀번호를 영영 풀 수 없다 → 이 파일과 별도로 안전한 곳에 보관한다(백업에 없다).
#   · 🔴 바꾸면 모든 회사가 비밀번호를 다시 넣어야 한다. 한 번 정하면 바꾸지 않는다.
# SMS_CRED_KEY=

# ── 결제 테스트 화면(/kicc-test) — 운영에서는 비워 둔다(꺼짐) ─────────────────
# KICC_TEST_ENABLED=
